{
  "manifest_version": 3,
  "name": "头条评论及正文提取器v1.0",
  "version": "1.0",
  "description": "提取今日头条文章正文及所有评论，支持导出为CSV、DOCX、MD格式",
  "author": "Editor By 11001",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.toutiao.com/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icon.svg",
    "32": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  }
}